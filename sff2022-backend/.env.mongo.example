# MongoDB Docker Environment Variables
# Copy this to .env for local development

# MongoDB Configuration
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your_secure_admin_password
MONGO_DB_NAME=sff_db
MONGO_PORT=27017

# Application Database User (used in mongo-init.js)
MONGO_APP_USER=sff_user
MONGO_APP_PASSWORD=your_secure_app_password
